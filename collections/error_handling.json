{
  "info": {
    "name": "Error Handling Tests",
    "description": "Test cases for common HTTP error scenarios — 400, 401, 403, 404, 422, 429, 500. Validates that APIs return correct error codes and meaningful error messages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "400 — Bad Request (Invalid Payload Format)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "this is not valid json {"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/records",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "records"]
        },
        "description": "Sends malformed JSON. Expects 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Error message is returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "401 — Unauthorized (No Auth Header)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/records",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "records"]
        },
        "description": "Request with no authentication header. Expects 401."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('WWW-Authenticate header present', function () {",
              "    pm.expect(pm.response.headers.has('WWW-Authenticate') ||",
              "               pm.response.json().hasOwnProperty('error')).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "403 — Forbidden (Insufficient Permissions)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{read_only_token}}" }],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/records/1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "records", "1"]
        },
        "description": "Authenticated but with insufficient permissions. Expects 403 Forbidden."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('Forbidden error message returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "404 — Not Found (Invalid Endpoint)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{bearer_token}}" }],
        "url": {
          "raw": "{{base_url}}/api/v1/this-endpoint-does-not-exist",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "this-endpoint-does-not-exist"]
        },
        "description": "Request to a non-existent endpoint. Expects 404 Not Found."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "422 — Unprocessable Entity (Validation Failure)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-a-valid-email\",\n  \"age\": -5\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/users",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users"]
        },
        "description": "Valid JSON but data fails server-side validation rules. Expects 422."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422', function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test('Validation errors returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('errors');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "429 — Rate Limit Exceeded",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{bearer_token}}" }],
        "url": {
          "raw": "{{base_url}}/api/v1/records",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "records"]
        },
        "description": "Simulates rate limit scenario. Expects 429 with Retry-After header."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Note: Run this request rapidly in the Collection Runner to trigger rate limiting",
              "if (pm.response.code === 429) {",
              "    pm.test('Status code is 429 Too Many Requests', function () {",
              "        pm.response.to.have.status(429);",
              "    });",
              "",
              "    pm.test('Retry-After header is present', function () {",
              "        pm.expect(pm.response.headers.has('Retry-After') ||",
              "                   pm.response.headers.has('X-RateLimit-Reset')).to.be.true;",
              "    });",
              "} else {",
              "    pm.test('Not yet rate limited — run faster or increase request volume', function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "500 — Server Error (Graceful Error Response)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"trigger_server_error\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/test/error",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "test", "error"]
        },
        "description": "Triggers a 500 server error. Validates graceful error response format."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 500', function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test('Error response is JSON (not HTML)', function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "pm.test('Error message field is present', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('error');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
